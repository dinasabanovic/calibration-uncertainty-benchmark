# ── Project-specific large artefacts ────────────────────────────────────────
# Per-sample probability vectors (regenerable with --save_probs; can be GB-scale)
results/probs/

# OpenML local cache (auto-downloaded on first run)
.openml/
~/.openml/

# Generated outputs that depend on results_raw.csv and can be regenerated by
# rerunning experiments/postprocess.py and experiments/make_figures.py.
# Comment these out if you want to commit the rendered figures for archival.
results/figures/*.png
results/figures/*.pdf
results/figures/*.svg

# Stats CSVs produced by postprocess.py (regenerable from results_raw.csv)
results/stats_*.csv
results/table_*.csv
results/table_*.tex
results/table1_summary*.csv
results/dataset_sizes_cache.json
results/task_ids.json
results/run_metadata.json
